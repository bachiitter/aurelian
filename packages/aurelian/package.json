    "./providers/google": "./dist/providers/google.mjs",
    "./providers/oauth": "./dist/providers/oauth.mjs",
    "./providers/oidc": "./dist/providers/oidc.mjs",
    "./providers/password": "./dist/providers/password.mjs",
    "./providers/types": "./dist/providers/types.mjs",
    "./providers/utils": "./dist/providers/utils.mjs",
    "./server": "./dist/server.mjs",
    "./storage": "./dist/storage/index.mjs",
    "./storage/cloudflare-kv": "./dist/storage/cloudflare-kv.mjs",
    "./storage/memory": "./dist/storage/memory.mjs",
    "./storage/redis": "./dist/storage/redis.mjs",
    "./storage/types": "./dist/storage/types.mjs",
