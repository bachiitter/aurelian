{
  "name": "aurelian",
  "type": "module",
  "version": "0.0.0",
  "description": "Just another auth library.",
  "author": "Bachitter Chahal <hello@bachitter.dev>",
  "license": "MIT",
  "homepage": "https://github.com/bachiitter/aurelian#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bachiitter/aurelian.git"
  },
  "bugs": {
    "url": "https://github.com/bachiitter/aurelian/issues"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./client": "./dist/client.mjs",
    "./profiles": "./dist/profiles.mjs",
    "./providers/google": "./dist/providers/google.mjs",
    "./server": "./dist/server.mjs",
    "./storage": "./dist/storage/index.mjs",
    "./storage/cloudflare-kv": "./dist/storage/cloudflare-kv.mjs",
    "./storage/memory": "./dist/storage/memory.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "tsdown": "^0.22.5",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0",
    "jose": "^6.2.3"
  }
}
