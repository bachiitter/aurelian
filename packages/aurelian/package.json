{
  "name": "aurelian",
  "type": "module",
  "version": "0.1.1",
  "description": "Just another auth library.",
  "author": "Bachitter Chahal <hello@bachitter.dev>",
  "license": "MIT",
  "homepage": "https://github.com/bachiitter/aurelian#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bachiitter/aurelian.git"
  },
  "bugs": {
    "url": "https://github.com/bachiitter/aurelian/issues"
  },
  "exports": {
    ".": "./dist/index.mjs",
    "./client": "./dist/client.mjs",
    "./profiles": "./dist/profiles.mjs",
    "./providers/code": "./dist/providers/code.mjs",
    "./providers/credentials": "./dist/providers/credentials.mjs",
    "./providers/discord": "./dist/providers/discord.mjs",
    "./providers/github": "./dist/providers/github.mjs",
    "./providers/google": "./dist/providers/google.mjs",
    "./providers/oauth": "./dist/providers/oauth.mjs",
    "./providers/oidc": "./dist/providers/oidc.mjs",
    "./providers/passkey": "./dist/providers/passkey.mjs",
    "./providers/password": "./dist/providers/password.mjs",
    "./providers/twitch": "./dist/providers/twitch.mjs",
    "./server": "./dist/server.mjs",
    "./storage": "./dist/storage/index.mjs",
    "./storage/cloudflare-kv": "./dist/storage/cloudflare-kv.mjs",
    "./storage/memory": "./dist/storage/memory.mjs",
    "./storage/sqlite": "./dist/storage/sqlite.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "smoke:dist": "node scripts/smoke-dist.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "tsdown": "^0.22.12",
    "typescript": "catalog:",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.2",
    "@standard-schema/spec": "^1.1.0",
    "hono": "^4.12.31",
    "jose": "^6.2.3"
  }
}
