{
  "compilerOptions": {
    "lib": [
      "ES2023",
      "WebWorker"
    ],
    "module": "preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": [
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "src"
  ]
}
